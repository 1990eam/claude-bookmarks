{
  "name": "claude-bookmarks",
  "displayName": "Claude Bookmarks",
  "description": "Every Claude Code bookmark for the open project, across all its sessions.",
  "version": "0.1.0",
  "publisher": "elian",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/1990eam/claude-bookmarks"
  },
  "type": "module",
  "main": "./dist/extension.cjs",
  "engines": {
    "vscode": "^1.125.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "claudeBookmarks",
          "title": "Claude Bookmarks",
          "icon": "media/bookmark.svg"
        }
      ]
    },
    "views": {
      "claudeBookmarks": [
        {
          "id": "claudeBookmarks.list",
          "name": "Bookmarks"
        }
      ]
    },
    "commands": [
      {
        "command": "claudeBookmarks.search",
        "title": "Search Bookmarks",
        "category": "Claude Bookmarks",
        "icon": "$(search)"
      },
      {
        "command": "claudeBookmarks.pickTimeframe",
        "title": "Pick Timeframe",
        "category": "Claude Bookmarks",
        "icon": "$(calendar)"
      },
      {
        "command": "claudeBookmarks.refresh",
        "title": "Refresh",
        "category": "Claude Bookmarks",
        "icon": "$(refresh)"
      },
      {
        "command": "claudeBookmarks.openSession",
        "title": "Open Session",
        "category": "Claude Bookmarks",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "claudeBookmarks.showResponse",
        "title": "Show Full Response",
        "category": "Claude Bookmarks",
        "icon": "$(open-preview)"
      },
      {
        "command": "claudeBookmarks.copyResume",
        "title": "Copy Resume Command",
        "category": "Claude Bookmarks",
        "icon": "$(copy)"
      },
      {
        "command": "claudeBookmarks.diagnostics",
        "title": "Diagnostics",
        "category": "Claude Bookmarks"
      }
    ],
    "viewsWelcome": [
      {
        "view": "claudeBookmarks.list",
        "when": "claudeBookmarks.state == noFolder",
        "contents": "Open a folder to see the Claude Code bookmarks of its sessions.\n[Open Folder](command:workbench.action.files.openFolder)"
      },
      {
        "view": "claudeBookmarks.list",
        "when": "claudeBookmarks.state == noStore",
        "contents": "No Claude Code bookmarks on this machine yet. Bookmark a response in the Claude panel and it shows up here."
      },
      {
        "view": "claudeBookmarks.list",
        "when": "claudeBookmarks.state == empty",
        "contents": "No bookmarks from this project's sessions in this timeframe.\n[Pick Timeframe](command:claudeBookmarks.pickTimeframe)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "claudeBookmarks.search",
          "when": "view == claudeBookmarks.list",
          "group": "navigation@0"
        },
        {
          "command": "claudeBookmarks.pickTimeframe",
          "when": "view == claudeBookmarks.list",
          "group": "navigation@1"
        },
        {
          "command": "claudeBookmarks.refresh",
          "when": "view == claudeBookmarks.list",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "claudeBookmarks.showResponse",
          "when": "view == claudeBookmarks.list && viewItem =~ /hasText/",
          "group": "inline@1"
        },
        {
          "command": "claudeBookmarks.copyResume",
          "when": "view == claudeBookmarks.list && viewItem =~ /^bookmark/",
          "group": "inline@2"
        },
        {
          "command": "claudeBookmarks.openSession",
          "when": "view == claudeBookmarks.list && viewItem =~ /^bookmark/",
          "group": "1_open@1"
        },
        {
          "command": "claudeBookmarks.showResponse",
          "when": "view == claudeBookmarks.list && viewItem =~ /hasText/",
          "group": "1_open@2"
        },
        {
          "command": "claudeBookmarks.copyResume",
          "when": "view == claudeBookmarks.list && viewItem =~ /^bookmark/",
          "group": "2_copy@1"
        }
      ],
      "commandPalette": [
        {
          "command": "claudeBookmarks.openSession",
          "when": "false"
        },
        {
          "command": "claudeBookmarks.showResponse",
          "when": "false"
        },
        {
          "command": "claudeBookmarks.copyResume",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "build": "esbuild src/ext/extension.ts --bundle --platform=node --format=cjs --target=node24 --external:vscode --outfile=dist/extension.cjs --sourcemap",
    "build:prod": "esbuild src/ext/extension.ts --bundle --platform=node --format=cjs --target=node24 --external:vscode --outfile=dist/extension.cjs --minify",
    "typecheck": "tsc -p .",
    "test": "node --test \"test/**/*.test.ts\"",
    "check": "npm run typecheck && npm test",
    "vscode:prepublish": "npm run check && npm run build:prod",
    "package": "vsce package --no-dependencies --skip-license -o claude-bookmarks.vsix",
    "install-local": "code --install-extension claude-bookmarks.vsix --force"
  },
  "devDependencies": {
    "@types/node": "~24.19.2",
    "@types/vscode": "1.125.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.2",
    "typescript": "~5.9.3"
  }
}
